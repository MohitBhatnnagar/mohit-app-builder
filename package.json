{
  "name": "mohit",
  "version": "0.1.0",
  "description": "Mohit: build full-stack apps from Claude, ChatGPT or Cursor over MCP. Database, sign-in, file storage and email included.",
  "private": true,
  "type": "module",
  "bin": {
    "mohit": "src/server.ts"
  },
  "scripts": {
    "mcp": "node src/server.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc -p . && tsc -p template",
    "test": "npm run typecheck && npm run smoke"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.11.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
