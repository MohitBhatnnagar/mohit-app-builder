# Copy this file to .env (same folder) and fill in the keys you want.
# Keys here are shared by every Mohit app. An app can override them in
# projects/<app>/.env. The AI never sees these values.

# Claude API key for the built-in AI helpers (aiText, aiChat, aiJson, aiStream).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Real email delivery through Resend (https://resend.com). Without these,
# email is only saved to each app's outbox.
RESEND_API_KEY=
# Sender address on a domain you verified in Resend.
EMAIL_FROM="My App <hello@yourdomain.com>"

# Optional: model for the AI helpers (default claude-opus-5-5).
# MOHIT_AI_MODEL=claude-opus-5-5
